    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.72.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
